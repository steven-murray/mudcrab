{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mudcrab",
  "mainBinaryName": "mudcrab-gui",
  "identifier": "io.github.steven-murray.mudcrab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mudcrab",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Game",
    "publisher": "Steven Murray",
    "copyright": "MIT OR Apache-2.0",
    "shortDescription": "Install and write modlists for Oblivion",
    "longDescription": "mudcrab installs a modlist into a Mod Organizer 2 instance from one window, and lets a list's author read and edit it: its mods' files, load order, conflicts, installers and notes. Every step is one of the mudcrab command line's commands.",
    "homepage": "https://github.com/steven-murray/mudcrab",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
