{#- The guide's closing text (its `footer`), as a page of its own after the
    last section. Nothing is written when the guide has none. -#}
{% import "site.j2" as site %}
{% if doc.docs.footer %}
{% with title = doc.docs.footer_title or "After installing", nav_order = 1000 %}{% include "front-matter.j2" %}{% endwith %}
{{ "{% raw %}" }}
# {{ doc.docs.footer_title or "After installing" }}

{{ doc.docs.footer | markup }}

{{ site.walk(doc, options, "nav", "closing.md") }}
{{ "{% endraw %}" }}
{% endif %}
