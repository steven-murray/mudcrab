{% for entry in doc.entries if entry.kind == "section" %}
{% if entry.anchor == section.anchor %}
{% with title = section.title, nav_order = 2 + loop.index %}{% include "front-matter.j2" %}{% endwith %}
{% endif %}
{% endfor %}
{{ "{% raw %}" }}
